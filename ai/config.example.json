{
  "enabled": false,
  "transport": "esp32_direct_https",
  "api_style": "openai_responses",
  "base_url": "https://api.openai.com/v1",
  "model": "gpt-6.1-terra",
  "api_key_setting": "ORBIT_AI_API_KEY",
  "trusted_ca_setting": "ORBIT_AI_CA_CERT",
  "content_language": "en",
  "capabilities": {
    "structured_outputs_documented": true,
    "web_search_documented": true,
    "live_verified": false
  },
  "research_policy": "evidence_required",
  "budget_targets": {
    "max_active_requests": 1,
    "max_evidence_references": 4,
    "max_output_tokens": 768,
    "max_response_bytes": 16384,
    "max_intro_text_bytes": 1536,
    "max_total_request_ms": 30000,
    "automatic_retries": 0,
    "max_model_requests_per_tap": 1,
    "max_web_search_calls": 1
  },
  "reasoning_effort": "none",
  "mode": "offline_mock_only",
  "contract_version": 2,
  "cache": {
    "entries": 3,
    "ready_ttl_ms": 0,
    "miss_ttl_ms": 600000,
    "storage": "ram_only",
    "key": "exact_metadata_topic_model_language_contract",
    "ready_lifetime": "current_track_session",
    "release_on_track_change": true
  },
  "https": {
    "implemented": true,
    "runtime_enabled": false,
    "private_settings_file": "firmware/OrbitS3/ai_local.h",
    "host": "api.openai.com",
    "port": 443,
    "path": "/v1/responses",
    "requires_trusted_utc": true,
    "requires_explicit_ca": true,
    "max_key_bytes": 512,
    "max_ca_bytes": 16384,
    "dns_timeout_ms": 3000,
    "tcp_timeout_ms": 2000,
    "tls_handshake_ms": 4000,
    "header_phase_ms": 2000,
    "body_idle_ms": 5000,
    "max_header_bytes": 8192,
    "max_chunk_framing_bytes": 8192,
    "min_internal_free_bytes": 196608,
    "min_internal_largest_bytes": 98304,
    "automatic_retries": 0,
    "background_owner_required": true,
    "live_ui_wired": true
  },
  "async_runtime": {
    "implemented": true,
    "runtime_enabled": false,
    "activation": "explicit ORBIT_AI_ENABLED, valid private settings, then UI selection",
    "command_queue_depth": 2,
    "result_queue_depth": 2,
    "worker_priority": 1,
    "worker_core": 0,
    "real_task_stack_bytes": 16384,
    "mock_task_stack_bytes": 8192,
    "pending_wait_ms": 20,
    "idle_wait": "task notification; indefinite",
    "allocation": "lazy PSRAM; no fallback; startup rollback on failure",
    "ui_cache_slots": 3,
    "generation_filter": "view token + track epoch",
    "preemption": "existing media TLS serialized, control/phone commands may preempt AI; explicit Retry",
    "deadline_policy": "original absolute UI deadline through queue/build/TLS/delivery; checked after begin and step",
    "cancel_policy": "no failure cooldown for intentional cancellation; minimum request gap and server/auth lockouts preserved",
    "delivery_backpressure": "bounded pending message; expire at deadline, then indefinite idle",
    "ownership": "non-copyable UI/worker; worker teardown after task quiescence cancels and releases lease"
  }
}
